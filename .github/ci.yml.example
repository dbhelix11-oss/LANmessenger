name: CI

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.27"
          cache: true

      # The Fyne GUI (cmd/lanmsg) uses OpenGL via cgo; `go test ./...` compiles
      # every package, so the test job needs its build prerequisites.
      - name: Fyne build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libgl1-mesa-dev xorg-dev libxkbcommon-dev

      - name: Formatting
        run: |
          unformatted=$(gofmt -l .)
          if [ -n "$unformatted" ]; then
            echo "These files need gofmt:"; echo "$unformatted"; exit 1
          fi

      - name: Vet
        run: go vet ./...

      - name: Test
        run: go test -race ./...

  cross-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.27"
          cache: true

      # The relay and the headless client core must build for every platform the
      # family runs. The Fyne GUI is packaged separately (fyne-cross) and is not
      # part of this matrix.
      - name: Cross-compile server + client core
        run: |
          for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64; do
            os=${target%/*}; arch=${target#*/}
            echo "== $os/$arch =="
            CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build ./cmd/lanmsg-server ./internal/...
          done

  # GUI releases only. Everything lanmsg-cli/lanmsg-remote-cli needs for a
  # release (cross-compiling, signing) happens locally via scripts/pi-release.sh
  # and cmd/lanmsg-signrelease — no CI dependency for routine releases. The
  # GUI (cmd/lanmsg) is the one binary that can't be cross-compiled from the
  # Pi (Fyne needs cgo + a native per-OS toolchain — see docs/DESIGN.md §12.2),
  # so a GUI-affecting release runs this job instead, once, on a version tag.
  #
  # This job deliberately does NOT sign anything — it only uploads unsigned
  # workflow artifacts. Signing always happens on the admin's own trusted
  # machine (see cmd/lanmsg-signrelease), never in CI and never on the relay,
  # so a compromised CI run could at worst produce a build nobody signs, not a
  # build that gets pushed to a client as trusted.
  gui-build:
    if: startsWith(github.ref, 'refs/tags/v')
    strategy:
      matrix:
        include:
          - os: ubuntu-latest
            goos: linux
          - os: macos-latest
            goos: darwin
          - os: windows-latest
            goos: windows
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.27"
          cache: true

      - name: Fyne build dependencies (Linux only)
        if: matrix.goos == 'linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y libgl1-mesa-dev xorg-dev libxkbcommon-dev

      - name: Install fyne
        run: go install fyne.io/fyne/v2/cmd/fyne@latest

      - name: Package GUI
        working-directory: cmd/lanmsg
        run: fyne package -os ${{ matrix.goos }}

      - uses: actions/upload-artifact@v4
        with:
          name: lanmsg-${{ matrix.goos }}
          path: |
            cmd/lanmsg/lanmessenger.tar.xz
            cmd/lanmsg/lanmessenger.app
            cmd/lanmsg/lanmessenger.exe
          if-no-files-found: ignore
